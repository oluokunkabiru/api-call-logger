# ─────────────────────────────────────────────────────────────────────────────
# API Call Logger — copy the lines you need into your application's .env.
# Every value shown is the default; you only need to set what you change.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch (false = nothing is logged, API calls keep working)
API_CALL_LOGGER_ENABLED=true

# ── Storage ──────────────────────────────────────────────────────────────────
API_CALL_LOGGER_TABLE=api_call_logs
# Database connection for the log table (empty = app default connection)
API_CALL_LOGGER_DB_CONNECTION=
# Your own model extending Oluokunkabiru\ApiCallLogger\Models\ApiCallLog
API_CALL_LOGGER_MODEL="Oluokunkabiru\ApiCallLogger\Models\ApiCallLog"
# Set to false after publishing the migration (--tag=api-call-logger-migrations)
API_CALL_LOGGER_RUN_MIGRATIONS=true

# ── Queue (write log records from a queued job) ──────────────────────────────
API_CALL_LOGGER_QUEUE=false
API_CALL_LOGGER_QUEUE_CONNECTION=
API_CALL_LOGGER_QUEUE_NAME=

# ── Automatic capture of every Http:: call ───────────────────────────────────
API_CALL_LOGGER_CAPTURE_HTTP_CLIENT=false
# Comma separated, wildcards allowed: *.vtpass.com,api.paystack.co
API_CALL_LOGGER_CAPTURE_ONLY_HOSTS=
API_CALL_LOGGER_CAPTURE_EXCEPT_HOSTS=

# ── Redaction ────────────────────────────────────────────────────────────────
# false = keep PII (BVN, NIN, ...) for debugging. Credentials are ALWAYS redacted.
API_CALL_LOGGER_REDACT_SENSITIVE=true
API_CALL_LOGGER_REDACT_REPLACEMENT="[REDACTED]"
# Extra keys added to the built-in lists (comma separated)
API_CALL_LOGGER_REDACT_KEYS=
API_CALL_LOGGER_SENSITIVE_KEYS=
# Longer strings become "<truncated N bytes>" (null = never truncate)
API_CALL_LOGGER_MAX_STRING_LENGTH=500
API_CALL_LOGGER_MAX_DEPTH=10

# Value patterns: caught by what they look like, under any key, in free text and URL paths
# Luhn-valid cards → 411111******1111
API_CALL_LOGGER_MASK_CARD_NUMBERS=true
# eyJ...eyJ...sig → [REDACTED:jwt]
API_CALL_LOGGER_MASK_JWT=true
# "Bearer xxx" / "Basic xxx" inside strings
API_CALL_LOGGER_MASK_AUTH_SCHEMES=true
# jo***@gmail.com
API_CALL_LOGGER_MASK_EMAILS=false
# +*********4567
API_CALL_LOGGER_MASK_PHONES=false
# Digit runs of at least this length in URL paths (/kyc/bvn/22222222222); null = off
API_CALL_LOGGER_MASK_URL_DIGITS=10

# ── Encryption at rest ───────────────────────────────────────────────────────
API_CALL_LOGGER_ENCRYPT=false
# Dedicated key (php artisan key:generate --show); empty = APP_KEY
API_CALL_LOGGER_ENCRYPTION_KEY=
API_CALL_LOGGER_ENCRYPT_COLUMNS=request_body,response_body,request_headers,response_headers,query

# ── Bodies & headers ─────────────────────────────────────────────────────────
API_CALL_LOGGER_LOG_HEADERS=true
# Bodies above this size (bytes) are not read, only their size is stored
API_CALL_LOGGER_MAX_BODY_BYTES=524288

# ── Retry attempts (Http::retry() → attempt 1, 2, 3) ─────────────────────────
API_CALL_LOGGER_TRACK_ATTEMPTS=true

# ── Correlation ──────────────────────────────────────────────────────────────
# Carry the correlation id into queued jobs (Laravel 11+ Context)
API_CALL_LOGGER_CORRELATION_TO_JOBS=true
# Also show it on every Log:: line
API_CALL_LOGGER_CORRELATION_IN_LOGS=false
# Adopt the caller's id from this header, e.g. X-Request-Id or traceparent (OpenTelemetry)
API_CALL_LOGGER_CORRELATION_REQUEST_HEADER=
# Send the id to providers in this header, e.g. X-Correlation-ID (empty = send nothing)
API_CALL_LOGGER_CORRELATION_FORWARD_HEADER=

# ── Idempotency ──────────────────────────────────────────────────────────────
API_CALL_LOGGER_IDEMPOTENCY_HEADERS=Idempotency-Key,X-Idempotency-Key
# Add a key to POST/PUT/PATCH/DELETE calls that have none (only for providers that support it)
API_CALL_LOGGER_AUTO_IDEMPOTENCY_KEY=false

# ── Retry rules ──────────────────────────────────────────────────────────────
API_CALL_LOGGER_RETRY_ENABLED=true
API_CALL_LOGGER_RETRY_SAFE_METHODS=GET,HEAD,OPTIONS
# Other methods: allow | confirm | deny
API_CALL_LOGGER_RETRY_UNSAFE=confirm
# Refuse unsafe retries without a stored idempotency key, even when confirmed
API_CALL_LOGGER_RETRY_REQUIRE_IDEMPOTENCY_KEY=false
# Ask for confirmation before retrying a call that already succeeded
API_CALL_LOGGER_RETRY_ONLY_FAILED=true
# Retries allowed per record (null = unlimited)
API_CALL_LOGGER_RETRY_MAX_PER_LOG=3
# Block a second retry of the same record for this many seconds (0 = no lock)
API_CALL_LOGGER_RETRY_LOCK_SECONDS=30

# ── Inbound webhooks (api-call-logger.inbound middleware) ────────────────────
API_CALL_LOGGER_INBOUND_CONTEXT=inbound-webhook
# Provider = URL segment after this one: /api/webhooks/flutterwave → flutterwave
API_CALL_LOGGER_INBOUND_SEGMENT=webhooks

# ── Pruning (null = keep forever) ────────────────────────────────────────────
API_CALL_LOGGER_PRUNE_DAYS=30

# ── Dashboard ────────────────────────────────────────────────────────────────
API_CALL_LOGGER_DASHBOARD_ENABLED=true
API_CALL_LOGGER_ROUTE_PREFIX=api-call-logs
# Comma separated middleware for the dashboard routes, e.g. web,auth
API_CALL_LOGGER_DASHBOARD_MIDDLEWARE=web
API_CALL_LOGGER_DASHBOARD_PER_PAGE=25

# Provider host mapping and retry credentials live in config/api-call-logger.php
# under 'providers', reading your own env vars, e.g.:
#   'vtpass' => ['hosts' => ['sandbox.vtpass.com'], 'retry_headers' => ['api-key' => env('VTPASS_API_KEY')]],
